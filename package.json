{
  "name": "hypora",
  "private": true,
  "version": "1.0.0",
  "description": "Hypora - 对标Typora的跨平台Markdown编辑器",
  "author": "Hypora Team",
  "main": "electron-main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5300 && cross-env NODE_ENV=development electron .\"",
    "icon": "node scripts/generate-icon.cjs",
    "pack:win": "node scripts/build-with-icon.cjs",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.hypora.app",
    "productName": "Hypora",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "electron-preload.js",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hypora"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/favicon.icns"
    },
    "linux": {
      "target": "deb",
      "icon": "public"
    }
  },
  "overrides": {
    "katex": "$katex"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tauri-apps/api": "^2.11.1",
    "element-plus": "^2.14.2",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "katex": "^0.17.0",
    "lottie-web": "^5.13.0",
    "marked": "^18.0.5",
    "marked-footnote": "^1.4.0",
    "mermaid": "^11.15.0",
    "pinia": "^3.0.4",
    "prismjs": "^1.30.0",
    "sass": "^1.101.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.2.3",
    "cross-env": "^10.1.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.1",
    "puppeteer-core": "^25.2.0",
    "sharp": "^0.35.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vue-tsc": "^3.3.5",
    "wait-on": "^9.0.10"
  }
}
